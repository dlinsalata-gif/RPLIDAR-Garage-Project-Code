#include "httplib.h"
#include "state.h"
#include "config.h"

#include <fstream>
#include <sstream>
#include <string>
#include <mutex>

// Load HTML file
std::string load_html() {
    std::ifstream file("index.html");

    if (!file.is_open()) {
        return "<h1>ERROR: index.html not found</h1>";
    }

    std::stringstream buffer;
    buffer << file.rdbuf();
    return buffer.str();
}

void start_web() {
    httplib::Server svr;

    
    svr.Get("/", [](const httplib::Request&, httplib::Response& res) {
        res.set_content(load_html(), "text/html");
    });

    svr.Get("/status", [](const httplib::Request&, httplib::Response& res) {
        std::lock_guard<std::mutex> lock(shared_state.mtx);

        int open_spots = Config::MAX_SPOTS - shared_state.car_count;
        if (open_spots < 0) open_spots = 0;

        std::string json = "{";
        json += "\"open_spots\":" + std::to_string(open_spots) + ",";
        json += "\"event\":\"" + shared_state.last_event + "\",";
        json += "\"event_time\":\"" + shared_state.last_event_time + "\"";
        json += "}";

        res.set_content(json, "application/json");
    });

    std::cout << "Web server running on port 5000..." << std::endl;

    svr.listen("0.0.0.0", 5000);
}
