#include <iostream>
#include <cmath>
#include <chrono>
#include <thread>

#include "sl_lidar.h"
#include "sl_lidar_driver.h"

#include "config.h"
#include "state.h"
#include "rfid.h"

using namespace sl;

static const int LIDAR_BAUD = 115200;

// Turn this on only if you want every LiDAR point again
static const bool DEBUG_LIDAR_RAW = false;

// This only prints points that are actually in your detection zone
static const bool DEBUG_DETECTION = true;

static float get_angle(const sl_lidar_response_measurement_node_hq_t& node)
{
    return node.angle_z_q14 * 90.0f / (1 << 14);
}

static float get_distance(const sl_lidar_response_measurement_node_hq_t& node)
{
    return node.dist_mm_q2 / 4.0f;
}

static bool angle_in_window(float angle, float target)
{
    return std::fabs(angle - target) <= Config::ANGLE_WINDOW;
}

void start_lidar()
{
    std::cout << "Lidar running (RPLIDAR A1 real SDK)" << std::endl;

    ILidarDriver* drv = *createLidarDriver();
    if (!drv)
    {
        std::cout << "Failed to create lidar driver" << std::endl;
        return;
    }

    IChannel* channel = *createSerialPortChannel(Config::LIDAR_PORT, LIDAR_BAUD);
    if (!channel)
    {
        std::cout << "Failed to create lidar channel" << std::endl;
        delete drv;
        return;
    }

    sl_result ans = drv->connect(channel);
    if (SL_IS_FAIL(ans))
    {
        std::cout << "Failed to connect to lidar" << std::endl;
        delete drv;
        return;
    }

    drv->setMotorSpeed();
    std::this_thread::sleep_for(std::chrono::milliseconds(500));

    ans = drv->startScan(0, 1);
    if (SL_IS_FAIL(ans))
    {
        std::cout << "Failed to start lidar scan" << std::endl;
        drv->stop();
        drv->setMotorSpeed(0);
        delete drv;
        return;
    }

    auto lastEventTime = std::chrono::steady_clock::now() - std::chrono::seconds(10);

    while (true)
    {
        sl_lidar_response_measurement_node_hq_t nodes[8192];
        size_t count = 8192;

        ans = drv->grabScanDataHq(nodes, count);

        if (SL_IS_FAIL(ans))
        {
            std::cout << "[LIDAR ERROR] Failed to grab scan data" << std::endl;
            std::this_thread::sleep_for(std::chrono::milliseconds(100));
            continue;
        }

        drv->ascendScanData(nodes, count);

        for (size_t i = 0; i < count; i++)
        {
            float angle = get_angle(nodes[i]);
            float distance = get_distance(nodes[i]);

            if (distance <= 0)
            {
                continue;
            }

            bool inEntryZone = angle_in_window(angle, Config::ENTRY_LINE);
            bool inExitZone  = angle_in_window(angle, Config::EXIT_LINE);
            bool closeEnough = distance <= Config::TRIGGER_DISTANCE;

            if (DEBUG_LIDAR_RAW)
            {
                std::cout << "[LIDAR] angle=" << angle
                          << " distance=" << distance
                          << std::endl;
            }

            // Only print meaningful LiDAR detection points
            if (DEBUG_DETECTION && (inEntryZone || inExitZone) && closeEnough)
            {
                std::cout << "[DETECT] angle=" << angle
                          << " distance=" << distance
                          << " zone=" << (inEntryZone ? "ENTRY" : "EXIT")
                          << std::endl;
            }

            if (!(inEntryZone || inExitZone) || !closeEnough)
            {
                continue;
            }

            auto now = std::chrono::steady_clock::now();
            auto secondsSinceLastEvent =
                std::chrono::duration_cast<std::chrono::seconds>(now - lastEventTime).count();

            if (secondsSinceLastEvent < Config::EVENT_COOLDOWN_SECONDS)
            {
                continue;
            }

            if (rfid_is_teacher_present())
            {
                std::cout << "[EVENT] "
                          << (inEntryZone ? "ENTER" : "EXIT")
                          << " ignored (teacher)"
                          << std::endl;

                lastEventTime = now;
                continue;
            }

            if (inEntryZone)
            {
                increment_count();

                std::cout << "[EVENT] ENTER -> "
                          << get_count()
                          << " angle=" << angle
                          << " distance=" << distance
                          << std::endl;
            }
            else if (inExitZone)
            {
                decrement_count();

                std::cout << "[EVENT] EXIT -> "
                          << get_count()
                          << " angle=" << angle
                          << " distance=" << distance
                          << std::endl;
            }

            lastEventTime = now;
        }
    }

    drv->stop();
    drv->setMotorSpeed(0);
    delete drv;
}
