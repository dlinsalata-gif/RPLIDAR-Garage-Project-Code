#.from flask import Flask, render_template, jsonify
import lidar_counter
from config import MAX_SPOTS

app = Flask(__name__)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/status")
def status():
    with lidar_counter.lock:
        open_spots = MAX_SPOTS - lidar_counter.car_count
        if open_spots < 0:
            open_spots = 0

        return jsonify(
            open_spots=open_spots,
            event=lidar_counter.last_event,
            event_time=lidar_counter.last_event_time
        )


def start_web():
    app.run(host="0.0.0.0", port=5000, threaded=True, use_reloader=False)
